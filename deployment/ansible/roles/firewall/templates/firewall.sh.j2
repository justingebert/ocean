#!/bin/sh
# MANAGED BY ANSIBLE (roles/firewall), do not edit on the host; re-runs overwrite it.
# Derived from the HTW firewall.sh (wagnera 13.2.2023).
################################################
# firewall.sh: Skript zur Konfiguration von iptables
# usage: runs at boot via ocean-firewall.service, re-applied by Ansible on change
################################################
# Alle Regeln aller Chains in Tabelle Filter loeschen
iptables -F
#
# Standart Policy fuer alle Chains DROP
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT DROP
#
# auf bestehenden und zugehoerigen verbindungen alles erlauben
iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
#
# loopback device zulassen
iptables -A INPUT -i lo -s 127.0.0.0/8 -d 127.0.0.0/8 -j ACCEPT
iptables -A OUTPUT -o lo -d 127.0.0.0/8 -s 127.0.0.0/8 -j ACCEPT
{% if firewall_allow_docker_bridge %}
#
# Ocean: host-local procs (docker-proxy, ssh -L) duerfen die Docker-Bridge erreichen
iptables -A OUTPUT -d 172.16.0.0/12 -j ACCEPT
{% endif %}
#
# NESSUS Netzwerkscanner
iptables -A INPUT -p tcp -s 10.45.64.36 -j ACCEPT
#
# Ping zulassen
iptables -A INPUT  -p icmp -s {{ htw_networks }} -j ACCEPT
iptables -A OUTPUT -p icmp -d {{ htw_networks }} -j ACCEPT
#
# Webproxy zulassen (für apt)
iptables -A OUTPUT -p tcp --dport 3128 -d 141.45.0.0/16 -j ACCEPT
#
# SSH INPUT zulassen
iptables -A INPUT -s {{ htw_networks }} -p tcp --dport 22 -j ACCEPT
#
# Ocean: Beszel agent (host network, so INPUT not DOCKER-USER): only the hub on ops may poll it.
iptables -A INPUT -s {{ hostvars[groups['ops'][0]].ip }} -p tcp --dport 45876 -j ACCEPT
#
# Ocean: container traffic. Published ports are DNAT'd to the container and
# pass FORWARD, not INPUT/OUTPUT, so the rules above never see it. Docker checks
# DOCKER-USER first and never flushes it: only HTW sources may reach a published
# port. What is open is whatever the compose stack publishes.
iptables -N DOCKER-USER 2>/dev/null || true
iptables -A DOCKER-USER -m state --state ESTABLISHED,RELATED -j RETURN
# Dozzle agent: only the hub on ops may connect (agent grants full log + exec access).
iptables -A DOCKER-USER -i {{ ansible_default_ipv4.interface }} -p tcp --dport 7007 ! -s {{ hostvars[groups['ops'][0]].ip }} -j DROP
iptables -A DOCKER-USER -i {{ ansible_default_ipv4.interface }} -s {{ htw_networks }} -j RETURN
iptables -A DOCKER-USER -i {{ ansible_default_ipv4.interface }} -s 10.45.64.36 -j RETURN
iptables -A DOCKER-USER -i {{ ansible_default_ipv4.interface }} -j DROP
#
# HTTP(S) OUTPUT zulassen
iptables -A OUTPUT -p tcp --dport 80 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 443 -j ACCEPT
#
# DNS zulassen
iptables -A OUTPUT -p udp --dport 53 -d {{ htw_networks }} -j ACCEPT
#
# NTP (Network Time Protocoll)
iptables -A OUTPUT -p udp --dport 123 -d 141.45.0.0/16 -j ACCEPT
iptables -A OUTPUT -p tcp --dport 123 -d 141.45.0.0/16 -j ACCEPT
#
# Quarantänenetz ignorieren
iptables -A INPUT -s 172.0.0.1/8 -j DROP
