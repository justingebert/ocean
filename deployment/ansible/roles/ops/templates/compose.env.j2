DOZZLE_REMOTE_AGENT={% for h in groups['app'] + groups['pg'] + groups['mongo'] %}{{ hostvars[h].ansible_host }}:7007|{{ h }}{{ '' if loop.last else ',' }}{% endfor %}

OCEAN_HOSTNAME={{ ansible_host }}
# Single quotes: the bcrypt hash contains `$`, which Compose would interpolate.
OCEAN_OPS_PASSWORD_HASH='{{ ocean_ops_password_hash }}'
BESZEL_KEY="{{ beszel_hub_pubkey }}"
BESZEL_ADMIN_EMAIL={{ beszel_admin_email }}
BESZEL_ADMIN_PASSWORD={{ beszel_admin_password }}
