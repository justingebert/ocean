{$OCEAN_HOSTNAME} {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
	encode gzip zstd

	# Dozzle and Beszel each have their own login (same user), Caddy only routes.
	handle /logs* {
		reverse_proxy dozzle:8080
	}

	# Beszel expects the prefix stripped.
	redir /resources /resources/
	handle_path /resources/* {
		reverse_proxy beszel:8090
	}

	handle / {
		root * /srv
		file_server
	}

	handle {
		respond 404
	}
}

:80 {
	redir https://{host}{uri} permanent
}
