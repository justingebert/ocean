{$OCEAN_HOSTNAME} {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem

	root * /usr/share/caddy
	encode gzip zstd

	# Backend API and its generated documentation.
	@api path /v1/* /swagger.json /docs/swagger-ui /docs/swagger-ui/*
	handle @api {
		reverse_proxy backend:9000
	}

	# asset bundles: long-cache, and a missing one should 404, not fallback to index.html.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# unknown paths serve index.html so React Router resolves them.
	handle {
		try_files {path} /index.html
		file_server
	}
}

:80 {
	redir https://{host}{uri} permanent
}
